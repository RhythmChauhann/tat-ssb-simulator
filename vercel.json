{
  "rewrites": [
    { "source": "/", "destination": "/admin.html" },
    { "source": "/test/:id", "destination": "/test.html?id=:id" }
  ],
  "crons": [
    { "path": "/api/cleanup", "schedule": "0 0 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}